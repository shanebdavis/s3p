import &StandardImport, &FsEasy, &LibMisc, &@aws-sdk/client-s3, &@aws-sdk/lib-storage, &@smithy/node-http-handler, {} &path

# NOTE: must be the local Lib/PromiseWorkerPool - art-standard-lib exports a
# same-named class whose queue() resolves with ALL results, not the job's own
PromiseWorkerPool = &PromiseWorkerPool

# s3.copyObject hard-fails above this size; larger objects require multipart UploadPartCopy
maxCopyObjectSize = 5 * 1024 ** 3

# metadata CopyObject preserves automatically, but multipart-copy and stream-copy must carry explicitly
preservedMetadataKeys =
  :ContentType
  :ContentEncoding
  :ContentDisposition
  :ContentLanguage
  :CacheControl
  :Expires
  :Metadata

http = &http
https = &https

fs = merge
  {createReadStream} = &fs
  {copyFile} = &fs.promises

# &@aws-sdk/client-s3.config.setPromisesDependency &bluebird

class S3 extends BaseClass

  @commonCopyOptionsSdkKeys =
    :ACL
    :CacheControl
    :ContentDisposition
    :ContentEncoding
    :ContentLanguage
    :ContentType
    :Expires
    :RequestPayer
    :StorageClass

  @commonSdkCopyOptionsByLowerCamelCaseKeys = object k from @commonCopyOptionsSdkKeys with-key lowerCamelCase k

  ## constructor
    IN: options:
      region: string, default: process.env.AWS_REGION
      useAccelerateEndpoint: boolean, default: false
      endpoint: string, default: process.env.S3_ENDPOINT (env var ignored when profile is set)
      forcePathStyle: boolean, default: true if endpoint is set
      profile: string - an AWS profile from ~/.aws/config & ~/.aws/credentials
        Resolved natively by the AWS SDK (requires @aws-sdk/client-s3 >= 3.598):
        credentials (including SSO, assumed roles and credential_process),
        region and endpoint_url all come from the profile unless explicitly
        overridden by other options. Standard AWS precedence still applies
        (e.g. the AWS_REGION env var overrides the profile's region).
      credentials: AwsCredentialIdentity or provider - passed through to S3Client
      maxSockets: number, default: undefined (SDK default: 50)
        Max concurrent HTTP connections. Size this to match the number of
        concurrent SDK calls or requests queue inside the HTTP handler.
      maxAttempts: number, default: 5
        Total tries per request (1 initial + retries). At high concurrency S3
        and the network drop connections ("socket hang up" / TimeoutError);
        these are transient and retryable and usually recover on the next try,
        so we retry (5 attempts) rather than aborting the whole operation. Uses
        the SDK's ADAPTIVE retry mode, which also client-side rate-limits when
        S3 returns 503 SlowDown (reachable once the socket pool is large).
      connectionTimeout: ms, default: 6000
        Fail a socket that can't connect this fast (then retry) instead of
        hanging.
      requestTimeout: ms, default: 120000
        Max time a single request/response may take before it is abandoned with
        a TimeoutError (then retried). throwOnRequestTimeout is set so the
        breach actually throws instead of only warning - bounding the "socket
        hang up" hang so a stuck connection is retried, not fatal.
      verbose: boolean, log client configuration on creation

  constructor: (options = {}) ->
    profile = options.profile
    endpoint = options.endpoint
    endpoint ?= process.env.S3_ENDPOINT if !profile
    maxSockets = options.maxSockets
    maxAttempts       = options.maxAttempts ? 5
    connectionTimeout = options.connectionTimeout ? 6000
    requestTimeout    = options.requestTimeout ? 120000
    @maxAttempts = maxAttempts

    log "s3p: S3-client maxSockets: #{maxSockets ? 'SDK-default (50)'} maxAttempts: #{maxAttempts}" if options.verbose

    @awsSdkS3 = new S3Client merge
      region: process.env.AWS_REGION
      # ADAPTIVE retry + generous attempts: transient "socket hang up"/TimeoutError
      # at high concurrency must be retried, not propagated (a single one used to
      # abort the whole sync via eachRecursive). Adaptive mode also rate-limits on
      # 503 SlowDown, which a large socket pool can provoke against one prefix.
      {} maxAttempts, retryMode: "adaptive"
      if endpoint
        {} endpoint, forcePathStyle: true
      if maxSockets
        # timeouts turn a stuck socket into a fast, retryable failure instead of a hang
        requestHandler: new NodeHttpHandler {}
          connectionTimeout:  connectionTimeout
          requestTimeout:     requestTimeout
          # without this, a requestTimeout breach only logs a warning (legacy
          # behavior); we need it to throw a TimeoutError so the SDK retries
          throwOnRequestTimeout: true
          httpAgent:  new http.Agent  {} maxSockets, keepAlive: true
          httpsAgent: new https.Agent {} maxSockets, keepAlive: true
      {region, useAccelerateEndpoint, forcePathStyle, profile, credentials} = options

  @getter
    s3: ->
      listBuckets:    (options = {}) -> Promise.resolve @awsSdkS3.send new ListBucketsCommand options
      listObjectsV2:  (options = {}) -> Promise.resolve @awsSdkS3.send new ListObjectsV2Command options
      getObject:      (options = {}) -> Promise.resolve @awsSdkS3.send new GetObjectCommand options
      copyObject:     (options = {}) -> Promise.resolve @awsSdkS3.send new CopyObjectCommand options
      deleteObject:   (options = {}) -> Promise.resolve @awsSdkS3.send new DeleteObjectCommand options
      headObject:     (options = {}) -> Promise.resolve @awsSdkS3.send new HeadObjectCommand options

      createMultipartUpload:   (options = {}) -> Promise.resolve @awsSdkS3.send new CreateMultipartUploadCommand options
      uploadPartCopy:          (options = {}) -> Promise.resolve @awsSdkS3.send new UploadPartCopyCommand options
      completeMultipartUpload: (options = {}) -> Promise.resolve @awsSdkS3.send new CompleteMultipartUploadCommand options
      abortMultipartUpload:    (options = {}) -> Promise.resolve @awsSdkS3.send new AbortMultipartUploadCommand options


  listBuckets: ->
    @s3.listBuckets()
    .then ({Buckets}) ->
      object {Name, CreationDate} from Buckets with-key Name with CreationDate

  ## _isTransientError
    True for connection-level failures that the AWS SDK's retry classifier does
    NOT reliably catch: "socket hang up" / TimeoutError and the raw socket error
    codes (see aws-sdk-js-v3 #4666). At s3p's concurrency these happen routinely
    and are safe to retry - a read-only list has no side effects.
  @transientErrorCodes =
    :ECONNRESET
    :ETIMEDOUT
    :ECONNREFUSED
    :EPIPE
    :ENOTFOUND
    :EAI_AGAIN
    :ECONNABORTED
    :ERR_SOCKET_CONNECTION_TIMEOUT

  @isTransientError: (error) ->
    return false unless error
    name    = error.name
    code    = error.code ? error.Code
    message = "#{error.message ? ''}"
    isTimeout = name == "TimeoutError"
    isCode    = code? && code in S3.transientErrorCodes
    matchesMessage = /socket hang up|socket disconnected|timeout|ECONNRESET|EPIPE|network|hangup/i.test message
    isTimeout || isCode || matchesMessage

  _isTransientError: (error) -> S3.isTransientError error

  ## _withTransientRetry
    Retry fn() on transient connection errors with exponential backoff + jitter.
    The SDK's own retries handle service errors (throttling, 5xx); this catches
    the connection-reset class the SDK gives up on, so a single "socket hang up"
    never propagates up to eachRecursive and aborts the whole operation.
    Non-transient errors (NoSuchKey, AccessDenied, ...) rethrow immediately.
    The optional third argument, onTransientFailure, is invoked on each transient
    failure before the retry, so callers like an adaptive worker pool can react to
    the congestion signal even though the job ultimately succeeds after retrying.
  _withTransientRetry: (label, fn, onTransientFailure) ->
    maxAttempts = @maxAttempts ? 5
    attempt = (n) =>
      Promise.then fn
      .catch (error) =>
        if @_isTransientError error
          onTransientFailure?()
        if n < maxAttempts && @_isTransientError error
          # exponential backoff (base 250ms) capped at 5s, with full jitter
          delay = Math.min 5000, 250 * 2 ** (n - 1)
          delay = (Math.random() * delay) | 0
          errorSummary = "#{error.name}: #{error.message}"
          log.warn "s3p: transient-retry #{n}/#{maxAttempts} in #{delay}ms - #{label} - #{errorSummary}"
          timeout delay
          .then -> attempt n + 1
        else throw error
    attempt 1

  ## list
    OUT:
      []
        Key:
        LastModified:
        Size
        ETag
        StorageClass
        Owner
  list: ({bucket, prefix, limit=1000, fetchOwner, startAfter, stopAt}) ->
    startTime = currentSecond()
    label = "list #{bucket}/#{prefix ? ''}@#{startAfter ? ''}"
    @_withTransientRetry label, =>
      @s3.listObjectsV2
        Bucket:     bucket
        Prefix:     prefix
        MaxKeys:    limit
        StartAfter: startAfter
        FetchOwner: fetchOwner

    .tapCatch (error) ->
      log.error S3.list-error: {} bucket, prefix, startAfter, limit, error

    .then (results) ->
      duration = currentSecond() - startTime
      if !results.Contents? then results.Contents = []
      unless results.Contents is Array
        log.warn S3.list-no-Contents: {} bucket, prefix, startAfter, limit, duration, results
        throw new Error "S3.list: Contents is not an array"

      else if duration > 60
        log.warn S3.list-slow: {} bucket, prefix, startAfter, limit, duration, results: merge results, Contents: "Array #{results.Contents.length}"

      if present stopAt
        array item in-array results.Contents when item.Key <= stopAt
      else
        results.Contents

  ## copy
    IN:
      options:
        size:       Bytes (optional) if provided and >= largeCopyThreshold (or > 5GB, copyObject's max), server-side multipart largeCopy is used
        bucket:     <String> (ignored if both from-bucket and to-bucket are provided)
        fromBucket: from-bucket (default: bucket)
        toBucket:   to-bucket (default: bucket)
        key:      <String>
        fromKey:  from-key (default: key)
        toKey:    to-key (default: key)
        fromFolder: string

        toFolder:   local folder

        toS3:       <S3> (default: this) - the destination-side S3 instance; server-side
                    copy commands are sent to it (correct region/endpoint), while reads
                    (getObject) use this instance
        streamCopy: <Boolean> - stream every byte through this machine:
                    getObject (this) -> lib-storage Upload (toS3). Required when the two
                    sides use different credentials or endpoints - server-side copy is
                    impossible there (one request = one signer).
    OUT:
      Promise.then -> see https://docs.aws.amazon.com/AWSJavaScriptSDK/latest/AWS/S3.html#copyObject-property > Callback > Parameters
        {} CopyObjectResult, ...
  copy: (options) ->
    if options extract largeCopyThreshold, scratchState
      copyScratchState = scratchState.copyScratchState ?= {}

    @_normalizeCopyOptions(options) extract
      fromBucket, fromFolder, fromKey
      toBucket, toFolder, toKey
      pretend, verbose
      size

    toS3 = options.toS3 ? this
    streamCopy = options.streamCopy

    # copyObject hard-fails above 5GB, so multipart is forced there regardless of threshold
    multipartThreshold = Math.min largeCopyThreshold ? maxCopyObjectSize, maxCopyObjectSize

    if !fromFolder && !toFolder && !streamCopy && size >= multipartThreshold
      @largeCopy {}
        fromBucket, fromKey
        toBucket, toKey
        pretend, verbose
        size
        toS3
        sdkCopyOptions:           @_getCommonCopyOptionsForSdk options
        largeCopyPartSize:        options.largeCopyPartSize
        largeCopyPartConcurrency: options.largeCopyPartConcurrency
        onTransientFailure:       options.onTransientFailure

    else
      copyOptions = merge
        if toFolder
          Bucket:     fromBucket
          Key:        fromKey

        else
          CopySource: encodeURIComponent "" #{fromBucket}/#{fromKey}
          Bucket:     toBucket
          Key:        toKey

        @_getCommonCopyOptionsForSdk options

      toLocalFile = if toFolder then path.join toFolder, toKey

      if verbose
        log.unquoted merge {}
          copyObject: copyOptions
          toLocalFile
          streamCopy

      if pretend
        timeout 1 -> pretend: true

      else if fromFolder
        fromFilePath = path.join fromFolder, fromKey
        if toBucket
          new Upload
            client: toS3.awsSdkS3
            params:
              Bucket: toBucket
              Key:    toKey
              Body:   fs.createReadStream fromFilePath

          .done()

        else
          createParentDirs toLocalFile, copyScratchState
          .then -> fs.copyFile fromFilePath, toLocalFile

      else if toFolder
        if /\/$/.test(toKey) && size == 0 # this is a folder
          createParentDirs
            path.join toLocalFile, "ignored-file-name"
            copyScratchState

        else
          createWriteStreamSafe toLocalFile, copyScratchState
          .then (writeStream) -> new Promise (resolve, reject) ->
            @s3.getObject copyOptions
            .then ({Body}) ->
              Body
              .pipe(writeStream);
              .on :finish resolve
              .on :error  reject

      else if streamCopy
        @_streamCopy {}
          fromBucket, fromKey
          toBucket, toKey
          toS3
          size
          sdkCopyOptions: @_getCommonCopyOptionsForSdk options
          streamQueueSize: options.streamQueueSize

      else
        doCopy = -> toS3.s3.copyObject copyOptions
        @_withTransientRetry "copy #{toBucket}/#{toKey}", doCopy, options.onTransientFailure

  delete: (options) ->
    @_withTransientRetry "delete #{options.bucket}/#{options.key}", =>
      @s3.deleteObject
        Bucket: options.bucket
        Key:    options.key

  ## largeCopy
    Server-side multipart copy: createMultipartUpload -> parallel uploadPartCopy
    (byte-range per part, zero data through this machine) -> completeMultipartUpload.
    All commands are sent to the destination-side client (toS3), so cross-region
    copies land correctly. Replaces the old shell-out to 'aws s3 cp'.

    Source metadata (ContentType, CacheControl, ...) is read via headObject and
    carried over explicitly - matching what copyObject does automatically.

    IN: options:
      fromBucket, fromKey, toBucket, toKey: strings (or bucket/key defaults, see _normalizeCopyOptions)
      size:                     <Number> REQUIRED - source object's byte size
      toS3:                     <S3> destination-side instance (default: this)
      sdkCopyOptions:           SDK-cased overrides (ACL, ContentType, StorageClass, ...)
      largeCopyPartSize:        <Number> bytes/part [default 100MB; auto-raised to keep <= 10000 parts]
      largeCopyPartConcurrency: <Number> concurrent uploadPartCopy calls per file [4]
      pretend, verbose
  largeCopy: (options) ->
    @_normalizeCopyOptions(options) extract
      fromBucket, fromKey
      toBucket, toKey
      pretend, verbose, size

    throw new Error "largeCopy requires options.size" unless size > 0

    toS3            = options.toS3 ? this
    sdkCopyOptions  = options.sdkCopyOptions ? @_getCommonCopyOptionsForSdk options
    partConcurrency = options.largeCopyPartConcurrency ? 4
    partSize        = Math.max
      options.largeCopyPartSize ? 100 * 1024 ** 2
      Math.ceil size / 10000 # S3 allows at most 10000 parts

    parts = array i til Math.ceil size / partSize
      {}
        PartNumber:       i + 1
        CopySourceRange:  "" bytes=#{i * partSize}-#{Math.min(size, (i + 1) * partSize) - 1}

    if verbose
      log.unquoted largeCopy: {} fromBucket, fromKey, toBucket, toKey, size, partSize, parts: parts.length

    if pretend
      return timeout 1 -> pretend: true

    copySource = encodeURIComponent "" #{fromBucket}/#{fromKey}
    partPwp = new PromiseWorkerPool partConcurrency

    # copyObject preserves metadata automatically; multipart must carry it explicitly
    @headObject bucket: fromBucket, key: fromKey
    .then (head) =>
      toS3.s3.createMultipartUpload merge
        {} Bucket: toBucket, Key: toKey
        object v, k from head when v? && k in preservedMetadataKeys
        sdkCopyOptions

    .then ({UploadId}) =>
      Promise.all array {PartNumber, CopySourceRange} in-array parts
        partPwp.queue =>
          doUploadPart = ->
            toS3.s3.uploadPartCopy {}
              Bucket:     toBucket
              Key:        toKey
              UploadId
              PartNumber
              CopySource: copySource
              CopySourceRange
            .then ({CopyPartResult}) -> {} PartNumber, ETag: CopyPartResult.ETag
          @_withTransientRetry "uploadPartCopy #{toBucket}/#{toKey}#part#{PartNumber}", doUploadPart, options.onTransientFailure

      .then (completedParts) ->
        toS3.s3.completeMultipartUpload
          Bucket:           toBucket
          Key:              toKey
          UploadId:         UploadId
          MultipartUpload:  Parts: completedParts

      .catch (error) ->
        # don't leave a half-finished multipart upload behind (they bill until aborted)
        toS3.s3.abortMultipartUpload
          Bucket:   toBucket
          Key:      toKey
          UploadId: UploadId
        .catch -> null
        .then -> throw error

  ## _streamCopy
    Cross-environment copy: every byte flows through this machine.
    getObject on this (source-side) instance -> lib-storage Upload on toS3.
    Upload handles multipart automatically; queueSize/partSize bound memory
    (roughly queueSize * partSize per in-flight file).

    Source metadata is carried from the getObject response; sdkCopyOptions
    (user-provided ACL, ContentType, ...) override it.
  _streamCopy: (options) ->
    {fromBucket, fromKey, toBucket, toKey, toS3, size, sdkCopyOptions, streamQueueSize} = options

    @s3.getObject {} Bucket: fromBucket, Key: fromKey
    .then (source) ->
      new Upload
        client:    toS3.awsSdkS3
        queueSize: streamQueueSize ? 4
        partSize:  Math.max
          16 * 1024 ** 2
          Math.ceil (size ? 0) / 10000
        params: merge
          {} Bucket: toBucket, Key: toKey, Body: source.Body
          object v, k from source when v? && k in preservedMetadataKeys
          sdkCopyOptions
      .done()

  # get object's metadata
  headObject: ({bucket, key}) ->
    @s3.headObject
      Bucket: bucket
      Key: key

  _normalizeCopyOptions: (options) ->
    options extract
      bucket, key
      fromBucket = bucket
      toBucket = bucket
      fromKey = key
      toKey = key
      size

    if isFunction toKey
      toKey = toKey fromKey, fromBucket, toBucket, options.size

    unless present(fromBucket) && present(toBucket) && present(fromKey) && present toKey
      throw new Error "" Missing one of: fromBucket, toBucket, fromKey, toKey or bucket or key as a default
    merge options, {} fromBucket, fromKey, toBucket, toKey

  _getCommonCopyOptionsForSdk: (options) ->
    object sdkKey, lowerCamelCasedKey from S3.commonSdkCopyOptionsByLowerCamelCaseKeys with-key sdkKey
      options[lowerCamelCasedKey]

  extractCommonCopyOptions: (options) ->
    object v, k from S3.commonSdkCopyOptionsByLowerCamelCaseKeys
      options[k]

  shouldSyncObjects: (options) ->
    @_normalizeCopyOptions(options) extract fromBucket, toBucket, fromKey, toKey
    Promise.then ->
      if options.size < 1024**2 || !options.size
        true
      else
        @headObject options
        .then ({ContentLength}) -> ContentLength != options.size

  ## syncObject
    IN: options:
      passed to copyObject and shouldSyncObject
      size: used to compare and decide if it should copy
    OUT:
      copied: Bool
      status: if not copied, explains why
  syncObject: (options) ->
    @shouldSyncObjects options
    .then (shouldSync) ->
      if shouldSync
        @copyObject options
        .then (result) -> merge result, copied: true

      else {} copied: false
        # status: "s3://#{toBucket}/#{toKey} exists and has same size (#{size}); skipping"
