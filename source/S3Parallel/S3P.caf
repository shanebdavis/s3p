import &path, &ArtStandardLib, &ArtClassSystem, &Lib
colors = terminalColors

S3C = &S3Comprehensions

itemsByKey = (itemList, toKey) ->
  object {Key, Size} in-array itemList with-key
      if toKey?
        toKey Key
      else Key
    Size

summarizeHistogramGroups =
  :bytes
  :kilobytes
  :megabytes
  :gigabytes
  :terabytes
  :petabytes
  :exabytes
  :zetabytes

summarizeHistogramGroupUnits =
  :_B
  :kB
  :mB
  :gB
  :tB
  :pB
  :eB
  :zB

class S3P
  ###########################################################
    READONLY Commands
  ###########################################################
  @list: (options) =>
    S3C.each merge options,
      returnValue: keys = []
      mapList: (l) -> each {Key} from-array l into keys with keys.push Key

  @summarize: (options) =>
    options extract summarizeFolders, groupBy
    summary =
      size: 0
      maxSize: null
      minSize: null
      maxSizeKey: null
      minSizeKey: null
      sizeHistogram: {}
      folders: summarizeFolders && {}
      groups: groupBy && {}

    S3C.each merge options,
      getProgress: ->
        []
          "" totalSize: #{} colors.green "" #{humanByteSize summary.size}
          "" minSize: #{} colors.green "" #{humanByteSize summary.minSize}
          "" maxSize: #{} colors.green "" #{humanByteSize summary.maxSize}
        .join ' '

      map: (item) ->
        {Size, Key} = item
        floorSize = humanByteSize
          Math.pow 2, 1 + logSize = (Math.log(Size) / Math.log(2)) | 0
          0

        group = summarizeHistogramGroups[groupKey = ((logSize + 1)/10) | 0] ? :big
        groupUnit = summarizeHistogramGroupUnits[groupKey]
        g = summary.sizeHistogram[group] ?=
          each i til 10 into out = items: 0 size: 0
            out[(1 << i) + groupUnit] = 0

        g.items += 1
        g.size += Size
        g[floorSize] = (g[floorSize] | 0) + 1

        if groupBy
          groupKey = groupBy item
          bucket = summary.groups[groupKey] ?= items: 0, size: 0
          bucket.items++
          bucket.size += Size

        if summarizeFolders
          folder = summary.folders
          each subFolder in-array
              dirname Key
              .split '/'

            folder = folder[subFolder] ?= size: 0, files: 0
            folder.size += Size
            folder.files++

        summary.size += Size
        if Size >= summary.maxSize ? Size
          summary.maxSize = Size
          summary.maxSizeKey = Key

        if Size <= summary.minSize ? Size
          summary.minSize = Size
          summary.minSizeKey = Key

        summary.minSize = Math.min
          summary.minSize ? Size
          Size

    .then (stats) ->
      summary.averageSize = summary.size / (stats.matchingItems ? stats.items) | 0
      if summarizeFolders
        humanize = (folder) ->
          folder.humanSize = humanByteSize folder.size if folder.size is Number
          each subFolder in-object folder when subFolder is Object
            humanize subFolder

        humanize summary.folders

      merge
        stats
        summary
        {}
          human: object v, k in-object summary with humanByteSize v when /size$/i.test k

  @compare: (options) =>
    options = S3C.normalizeOptions options
    options extract
      logToDelete, logToCopy, logToReplace, verbose, toKey
      bucket
      fromFolder
      toBucket
      toFolder
    unless toBucket
      throw new Error "toBucket required"

    S3C.each merge
      options,
      returning: stats = {}
        counts =
          needToCopy:         0
          needToReplace:      0
          needToDelete:       0
          missingInTarget:    0
          different:          0
          replaceSmaller:     0
          replaceBigger:      0
          same:               0
        bytes =
          needToCopy:         0
          needToDelete:       0
          needToReplace:      0
          needToReplaceWith:  0
          same:               0

      getProgress: ->
        compactFlatten []
          if counts.same > 0          then "" same: #{} colors.green "" #{counts.same}(#{humanByteSize bytes.same})
          if counts.needToCopy > 0    then "" toCopy: #{} colors.green "" #{counts.needToCopy}(#{humanByteSize bytes.needToCopy})
          if counts.needToReplace > 0 then "" toReplace: #{} colors.green "" #{counts.needToReplace}(#{humanByteSize bytes.needToReplace} with #{humanByteSize bytes.needToReplaceWith})
          if counts.needToDelete > 0  then "" toDelete: #{} colors.green "" #{counts.needToDelete}(#{humanByteSize bytes.needToDelete})
        .join ' '

      compare: true
      mapList: (sourceItems, targetItems) ->

        reverseKeyMap = toKey &&  object {Key} in sourceItems with-key toKey Key with Key

        objectDiff
          itemsByKey sourceItems, toKey  # , options.prefix # right now these are somewhat asymetric - the source prefix is mainatined when copying to a prefix
          itemsByKey targetItems
          # added
          (key, sourceValue) ->
            fromKey = reverseKeyMap?[key] ? key
            log "aws s3 cp #{createS3Url bucket, fromFolder, fromKey} #{createS3Url toBucket, toFolder, key} # #{humanByteSize sourceValue}" if logToCopy || verbose
            bytes.needToCopy += sourceValue; counts.needToCopy++; counts.missingInTarget++

          # removed
          (key, targetValue) ->
            log "rm #{createS3Url toBucket, toFolder, key} # #{humanByteSize targetValue}" if logToDelete || verbose
            bytes.needToDelete += targetValue; counts.needToDelete++

          # changed
          (key, sourceValue, targetValue) ->
            fromKey = reverseKeyMap?[key] ? key
            log "aws s3 cp #{createS3Url bucket, fromFolder, fromKey} #{createS3Url toBucket, toFolder, key} # replace #{humanByteSize targetValue} with #{humanByteSize sourceValue}" if logToReplace || verbose
            counts.different++
            counts.needToReplace++
            bytes.needToReplace+=targetValue
            bytes.needToReplaceWith+=sourceValue
            if sourceValue > targetValue
                              counts.replaceSmaller++
            else              counts.replaceBigger++

          # same
          (key, value) ->
            bytes.same += value
            counts.same++

          # compare
          # (item1, item2) -> item1.Size == item2.Size

    .then (stats) ->
      cleanStats = (s) ->
        object v in s when v != 0
          if v is Object
            cleanStats v
          else v
      cleanStats stats

  ###########################################################
    READ/WRITE Commands
  ###########################################################
  ##
    IN: options:
      all the each options plus:
      toBucket: <String> [Default: options.bucket] - target bucket
      toPrefix: <String> optional - prepend to key for toKey
      toKey: (optional) <Function> (fromKey, fromBucket, toBucket, size) -> to-key-string
      copyConcurrency       [100]                   server-side mode: number of active copies < largeCopyThreshold (single copyObject call each)
      largeCopyConcurrency  [copyConcurrency/4]     server-side mode: number of active copies >= largeCopyThreshold (default 100MB; parallel server-side multipart uploadPartCopy)
      streamMemory          [512MB]                 stream mode: local memory budget for streaming buffers; streamConcurrency derives from it
      streamConcurrency     [streamMemory / 64MB]   stream mode: number of files actively streaming through this machine (one pool, all sizes)
      maxQueueSize          [copyConcurrency * 10]  max number of copy-jobs to queue before throttling s3.lists
  @copy: (options) =>
    @_copyWrapper options, (updatedOptions) =>
      S3C.eachPromises updatedOptions

  ##
    IN: options:
      bucket:                         <String> required - bucket to delete FROM
      confirmDeleteItemsFromBucket:   <String> required - must === bucket (safety)
      prefix, filter, pattern, etc.   standard S3Comprehensions.each options
      pretend:                        <Boolean> if true, lists but does NOT delete
      deleteConcurrency:              <Number>  [500] max in-flight delete calls
    OUT:
      finalStats:
        deletedFiles
        deletedBytes
        ...
  @delete: (options) =>
    options extract
      bucket
      confirmDeleteItemsFromBucket
      dryrun
      pretend = dryrun
      verbose
      stats
      deleteConcurrency = 500
      deletePwp
      region, endpoint, useAccelerateEndpoint
      profile
      credentials
      maxSockets
      maxAttempts
      connectionTimeout
      requestTimeout
      listConcurrency = 100
      s3

    unless pretend || confirmDeleteItemsFromBucket == bucket
      throw new Error ""
        confirm-delete-items-from-bucket (#{confirmDeleteItemsFromBucket})
        must exactly match bucket (#{bucket})
        (hint: use --dryrun or --pretend to skip this check)

    deletePwp ?= new PromiseWorkerPool deleteConcurrency
    maxSockets ?= deleteConcurrency + listConcurrency
    s3 ?= new &Lib/S3 {} region, endpoint, useAccelerateEndpoint, profile, credentials, maxSockets, maxAttempts, connectionTimeout, requestTimeout, verbose

    stats ?= {}
    stats.deletedFiles = 0
    stats.deletedBytes = 0

    S3C.eachPromises merge options,
      stats
      map: ({Key, Size}) ->
        deletePwp.queue ->
          if pretend
            Promise.then ->
              log "#{if pretend then 'PRETEND ' else ''}delete s3://#{bucket}/#{Key} # #{humanByteSize Size}" if verbose
              stats.deletedFiles++
              stats.deletedBytes += Size
          else
            s3.delete {} bucket, key: Key
            .then ->
              log "delete s3://#{bucket}/#{Key} # #{humanByteSize Size}" if verbose
              stats.deletedFiles++
              stats.deletedBytes += Size

    .then (info) ->
      finalStats: S3P.getStatsWithHumanByteSizes merge info, stats

  @sync: (options) =>
    @_copyWrapper options, (options2) ->
      options2 extract
        map as copyFile
        stats
        overwrite
        dryrun
        pretend = dryrun
        toKey
        toBucket

      stats.toDeleteFiles = 0
      stats.toDeleteBytes = 0
      stats.toReplaceFiles = 0
      stats.toReplaceBytes = 0
      stats.toReplaceWithBytes = 0
      stats.replacedFiles = 0
      stats.replacedBytes = 0

      stats.unchangedFiles = 0
      stats.unchangedBytes = 0

      S3C.each merge
        objectWithout options2, :map
        compare: true
        getProgress: (duration) ->
          options2.getProgress duration
          + ""
            \_same: #{} colors.green "" #{stats.unchangedFiles}(#{humanByteSize stats.unchangedBytes})
            toDelete: #{} colors.green "" #{stats.toDeleteFiles}(#{humanByteSize stats.toDeleteBytes})

        mapList: (sourceItems, targetItems) ->
          copyPromises = []

          reverseKeyMap = toKey && object {Key} in sourceItems with-key toKey Key with Key

          objectDiff
            itemsByKey sourceItems, toKey
            itemsByKey targetItems
            # added
            (key, sourceValue) ->
              fromKey = reverseKeyMap?[key] ? key
              copyPromises.push copyFile {} Key: fromKey, Size: sourceValue

            # removed
            (key, targetValue) ->
              log "aws s3 rm s3://#{toBucket}/#{key} # you must do this. size: #{humanByteSize targetValue}"
              stats.toDeleteBytes += targetValue
              stats.toDeleteFiles++

            # changed
            (key, sourceValue, targetValue) ->
              fromKey = reverseKeyMap?[key] ? key
              if overwrite
                log "# overwriting s3://#{toBucket}/#{key} - replacing targetSize: #{targetValue} with sourceSize #{sourceValue}"
                copyPromises.push copyFile {} Key: fromKey, Size: sourceValue
                stats.replacedFiles++
                stats.replacedBytes += targetValue
              else
                log "# NOT overwriting s3://#{toBucket}/#{key} - replacing targetSize: #{targetValue} with sourceSize #{sourceValue} (use overwrite: true to overwrite)"
                stats.toReplaceFiles++
                stats.toReplaceBytes += targetValue
                stats.toReplaceWithBytes = sourceValue

            # same
            (key, value) ->
              stats.unchangedBytes += value
              stats.unchangedFiles++

          Promise.all copyPromises

  ######################################################
    PRIVATE
  ######################################################

  ## @_copyWrapper is used by @copy and @sync to share copy-code
    IN:
      options - all the options you pass to @copy or @sync
      eachFunction: (updatedOptions) ->

      updatedOptions are options which can be passed directly to S3C.each.
      In particular, @_copyWrapper defines crical shared copy-code:
        map: ->
        getProgress: ->
        throttle: ->

      It also creates the basic stats object, which it uses to return the final results.
      TODO: this stats-object with final 'humanize' should become the base line for all S3P

  @_copyWrapper: (options, eachFunction) =>
    options = S3C.normalizeOptions options
    options extract
      s3
      toKey
      stats
      pretend
      verbose
      quiet
      copyConcurrency
      largeCopyConcurrency
      maxQueueSize
      copyPwp
      largeCopyPwp
      largeCopyThreshold
      # opt-in: continue past copies that exhaust their transient-error retries,
      # instead of aborting. Default false: an exhausted transient copy is fatal,
      # because skipping it produces an INCOMPLETE copy and that must be a
      # conscious choice. When true, such files are logged and counted in
      # finalStats.transientCopyFailure{Files,Bytes} and the run continues.
      skipFailedTransientCopies = false

      # s3 options
      region
      useAccelerateEndpoint
      endpoint
      maxSockets
      maxAttempts
      connectionTimeout
      requestTimeout
      listConcurrency = 100
      profile
      fromProfile
      fromRegion
      fromEndpoint
      fromCredentials
      toProfile
      toRegion
      toEndpoint
      toCredentials
      toS3
      copyMode
      largeCopyPartSize
      largeCopyPartConcurrency
      streamQueueSize = 4
      streamMemory = 512 * 1024 ** 2
      streamConcurrency
    maxSockets ?= copyConcurrency + listConcurrency

    s3 ?= new &Lib/S3 {}
      region:       fromRegion ? region
      endpoint:     fromEndpoint ? endpoint
      profile:      fromProfile ? profile
      credentials:  fromCredentials
      useAccelerateEndpoint
      maxSockets
      maxAttempts
      connectionTimeout
      requestTimeout
      verbose

    # destination-side client: server-side copy commands must be sent to the
    # destination's region/endpoint; shares the source client when config matches
    toS3 ?=
      if toProfile || toRegion || toEndpoint || toCredentials
        new &Lib/S3 {}
          region:       toRegion ? region
          endpoint:     toEndpoint ? endpoint
          profile:      toProfile ? profile
          credentials:  toCredentials
          useAccelerateEndpoint
          maxSockets
          maxAttempts
          connectionTimeout
          requestTimeout
          verbose
      else s3

    ## copy-strategy selection: explicit and dumb
      Different credentials or endpoints per side make server-side copy impossible
      (one request = one signer), so those force stream mode: every byte flows
      through this machine via getObject -> Upload.
      A different region alone stays server-side: copy commands go to the
      destination-region client (toS3) and reference the source via CopySource.
      Override with copyMode: 'server' | 'stream' for odd cases.
    streamCopy = switch copyMode
      when :server then false
      when :stream then true
      else
        (toProfile ? profile) != (fromProfile ? profile) ||
        (toEndpoint ? endpoint) != (fromEndpoint ? endpoint) ||
        toCredentials != fromCredentials

    ## stream mode concurrency: memory is the real constraint
      Server-side copies are cheap requests, so copyConcurrency/largeCopyConcurrency
      bound request fan-out. A streaming file instead buffers up to
      streamQueueSize * 16MB locally, so stream mode uses ONE pool whose size
      derives from the streamMemory budget (or set streamConcurrency directly).
    streamConcurrency ?= Math.max 1, Math.floor streamMemory / (streamQueueSize * 16 * 1024 ** 2)
    streamPwp = new PromiseWorkerPool streamConcurrency

    if streamCopy && verbose
      log "s3p: cross-environment copy: streaming every byte through this machine (getObject -> multipart Upload), #{streamConcurrency} files at a time"

    stats ?= {}
    stats.copiedBytes = 0
    stats.copiedBytesPerSecond = 0
    stats.copyingBytesInFlight = 0
    stats.copyingBytesStarted = 0
    stats.copyingFilesStarted = 0
    stats.copiedFiles = 0

    throw new Error "toBucket or toFolder required" unless (present options.toBucket) || present options.toFolder
    eachFunction merge options, {}
      stats
      throttle: -> copyPwp.queueSize + largeCopyPwp.queueSize + streamPwp.queueSize >= maxQueueSize
      getProgress: (duration) ->
        compactFlatten []
          "" copied
          "" #{} colors.green "" #{stats.copiedFiles}/#{stats.copyingFilesStarted} #{humanByteSize stats.copiedBytes}/#{humanByteSize stats.copyingBytesStarted}
          colors.blue "" #{humanByteSize stats.copiedBytesPerSecond = stats.copiedBytes / duration}/s
          "" inFlight: #{} colors.green humanByteSize stats.copyingBytesInFlight
          if streamCopy
            "" streamWorkers: #{} colors.green "" #{streamPwp.activeWorkers}
          else
            "" copyWorkers: #{} colors.green "" #{copyPwp.activeWorkers} + #{largeCopyPwp.activeWorkers}
          if 0 < copyPwp.queueSize + largeCopyPwp.queueSize + streamPwp.queueSize
            "" copyQueue: #{} colors.green "" #{copyPwp.queueSize + largeCopyPwp.queueSize + streamPwp.queueSize}
          colors.yellow "PRETENDING" if pretend
        .join ' '

      map: ({Key: key, Size}) ->
        stats.copyingFilesStarted++
        stats.copyingBytesStarted += Size

        pool =
          if streamCopy                     then streamPwp # stream mode: one memory-bounded pool, size is irrelevant
          else if Size < largeCopyThreshold then copyPwp
          else                                   largeCopyPwp
        pool.queue ->
          stats.copyingBytesInFlight += Size
          options = merge
            s3.extractCommonCopyOptions options
            {}
              pretend
              verbose
              options.bucket
              options.toBucket
              options.toFolder
              key
              toKey
              largeCopyThreshold
              size: Size
              toS3
              streamCopy
              largeCopyPartSize
              largeCopyPartConcurrency
              streamQueueSize
              # let the adaptive pool see transient failures even though s3.copy
              # retries and (usually) succeeds - otherwise it would only ever grow
              onTransientFailure: -> pool.notifyTransientFailure?()

          s3.copy options
          .then ->
            stats.copyingBytesInFlight -= Size
            stats.copiedFiles++
            stats.copiedBytes += Size

          .catch (error) ->
            stats.copyingBytesInFlight -= Size
            if error.name == :NoSuchKey || error.name == :NotFound || /NoSuchKey|NotFound/.test error.message
              unless quiet then log.warn "" s3p: skipping missing key (source deleted during operation): #{key} (#{humanByteSize Size})
              stats.keyDoesNotExistFiles =
                stats.keyDoesNotExistFiles ? 0
                + 1
              stats.keyDoesNotExistBytes =
                stats.keyDoesNotExistBytes ? 0
                + Size

            else if s3._isTransientError error
              # transient connection error that exhausted all retries (see S3._withTransientRetry).
              unless skipFailedTransientCopies
                # DEFAULT: fatal. Skipping would leave an incomplete copy silently;
                # abort so the incompleteness is a conscious, opt-in choice.
                log.error "" s3p: ABORTING - transient copy failure after retries: s3://#{options.toBucket}/#{key} (#{humanByteSize Size}) - #{error.name}: #{error.message}. Re-run, lower --copy-concurrency/--list-concurrency, or pass --skip-failed-transient-copies to skip and continue.
                throw error

              # opt-in: record the skipped file and continue (a re-sync will pick it up)
              log.warn "" s3p: SKIPPED (transient copy failure after retries): s3://#{options.toBucket}/#{key} (#{humanByteSize Size}) - #{error.name}: #{error.message}
              stats.transientCopyFailureFiles =
                stats.transientCopyFailureFiles ? 0
                + 1
              stats.transientCopyFailureBytes =
                stats.transientCopyFailureBytes ? 0
                + Size
              stats.transientCopyFailureKeys =
                stats.transientCopyFailureKeys ? []
                .concat key

            else throw error

    .then (stats) ->
      delete stats.copyingBytesInFlight
      delete stats.copyingFilesStarted
      delete stats.copyingBytesStarted
      stats.copiedBytesPerSecond = stats.copiedBytes / stats.duration
      finalStats: @getStatsWithHumanByteSizes stats

  @getStatsWithHumanByteSizes: (stats) ->
    merge
      object v in stats
        if v is Number
          if abs(v) < 100
            round v, .01
          else
            round v

        else v
      human: object stat, key in stats when /byte|size/i.test key
        humanByteSize stat
