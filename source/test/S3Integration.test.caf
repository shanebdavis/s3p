import &StandardImport, &MinioTestHelper

testKeys =
  :test-folder/hello.txt
  :test-folder/world.txt
  :other/file.txt

setupTestScenario :S3Integration testKeys, ({endpoint, testBucket}) ->

  test "ls returns array of key strings" ->
    ls
      bucket:   testBucket
      endpoint: endpoint
      quiet:    true

    .then (keys) ->
      each key in-array testKeys
        assert.ok
          key in keys
          "" Expected #{key} in #{JSON.stringify keys}

  test "S3P.list returns array of key strings" ->
    S3P.list
      bucket:   testBucket
      endpoint: endpoint
      quiet:    true

    .then (keys) ->
      assert.ok keys is Array
      each key in-array testKeys
        assert.ok
          key in keys
          "" Expected #{key} in #{JSON.stringify keys}

  # regression: the returning-option was dropped by normalizeOptions, so compare
  # returned only listing stats instead of its counts/bytes discrepancy summary
  test "S3P.compare returns the discrepancy summary" ->
    S3P.compare
      bucket:   testBucket
      toBucket: testBucket
      endpoint: endpoint
      quiet:    true

    .then ({counts}) ->
      assert.eq counts.same, testKeys.length
