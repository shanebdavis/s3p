import &StandardImport, &MinioTestHelper

testKeys =
  :test-folder/hello.txt
  :test-folder/world.txt
  :other/file.txt

setupTestScenario :S3Integration testKeys, ({endpoint, testBucket}) ->

  test "ls returns array of key strings" ->
    ls
      bucket:   testBucket
      endpoint: endpoint
      quiet:    true

    .then (keys) ->
      each key in-array testKeys
        assert.ok
          key in keys
          "" Expected #{key} in #{JSON.stringify keys}

  test "S3P.list returns array of key strings" ->
    S3P.list
      bucket:   testBucket
      endpoint: endpoint
      quiet:    true

    .then (keys) ->
      assert.ok keys is Array
      each key in-array testKeys
        assert.ok
          key in keys
          "" Expected #{key} in #{JSON.stringify keys}

  # regression: the returning-option was dropped by normalizeOptions, so compare
  # returned only listing stats instead of its counts/bytes discrepancy summary
  test "S3P.compare returns the discrepancy summary" ->
    S3P.compare
      bucket:   testBucket
      toBucket: testBucket
      prefix:   "test-folder/"
      endpoint: endpoint
      quiet:    true

    .then ({counts}) ->
      assert.eq counts.same, 2

  test "S3P.sync actually copies files (same environment)" ->
    S3P.sync
      bucket:   testBucket
      toBucket: testBucket
      prefix:   "test-folder/"
      toPrefix: "sync-copy/"
      endpoint: endpoint
      quiet:    true

    .then ({finalStats}) ->
      assert.eq finalStats.copiedFiles, 2

      S3P.list
        bucket:   testBucket
        prefix:   "sync-copy/"
        endpoint: endpoint
        quiet:    true

    .then (keys) ->
      assert.eq keys.slice().sort(), ["sync-copy/hello.txt", "sync-copy/world.txt"]

      # second sync: everything already there, nothing copied
      S3P.sync
        bucket:   testBucket
        toBucket: testBucket
        prefix:   "test-folder/"
        toPrefix: "sync-copy/"
        endpoint: endpoint
        quiet:    true

    .then ({finalStats}) ->
      assert.eq finalStats.copiedFiles,    0
      assert.eq finalStats.unchangedFiles, 2
