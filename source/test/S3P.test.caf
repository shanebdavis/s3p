import &StandardImport, &TestLib

describe
  list: ->
    test "returns array of key strings" ->
      S3P.list
        quiet: true
        s3: mockS3
          :alpha
          :beta
          :gamma

      .then (keys) ->
        assert.ok keys is Array
        assert.eq keys, [] :alpha :beta :gamma

    test "returns empty array for no items" ->
      S3P.list
        quiet: true
        s3: mockS3()

      .then (keys) ->
        assert.ok keys is Array
        assert.eq keys, []

  each: ->
    test :3-items ->
      S3Comprehensions.each
        limit: 2
        quiet: true
        s3: mockS3
          :alpha
          :beta
          :gamma

      .then (out) ->
        assert.selectedEq
          items: 3
          out

    test "limit:3" ->
      S3Comprehensions.each
        quiet: true
        limit: 3
        s3: mockS3
          :alpha
          :beta
          :gamma

      .then (out) ->
        assert.selectedEq
          items: 3
          out


    test "limit:4" ->
      S3Comprehensions.each
        quiet: true
        limit: 4
        s3: mockS3
          :alpha
          :beta
          :gamma

      .then (out) ->
        assert.selectedEq
          items: 3
          out

    test "limit:2 large common prefix" ->
      S3Comprehensions.each
        quiet: true
        limit: 2
        s3: mockS3
          :some/path/to/my/files/alpha
          :some/path/to/my/files/beta
          :some/path/to/my/files/gamma

      .then (out) ->
        assert.selectedEq
          items: 3
          out

    test :each_custom_count_3 ->
      count = 0
      S3Comprehensions.each
        quiet: true
        limit: 2
        map: -> count++
        s3: mockS3 files =
          :alpha
          :beta
          :gamma

      .then (out) ->
        assert.eq files.length, count
        assert.eq out.items, count

    test :each_custom_count_10 ->
      count = 0
      S3Comprehensions.each
        quiet: true
        limit: 2
        map: -> count++
        s3: mockS3 files =
          :059
          :0934t09g
          :alpha
          :alpha123
          :alpha9
          :as09df
          :asd
          :asdf
          :beta
          :gamma

      .then (out) ->
        assert.eq files.length, count
        assert.eq out.items, count

    test :largeList ->
      getLargeFileList()
      .then (files) ->
        S3Comprehensions.each
          quiet: true
          s3: mockS3 files

        .then (result) ->
          assert.selectedEq
            items:  files.length
            result

  copy: ->
    ## helper: mock S3 with a copy method that rejects with NoSuchKey for specific keys
    mockS3WithFailingCopy = (keys, failKeys) ->
      base = mockS3 keys...
      merge base,
        copy: (options) ->
          key = options.key ? options.fromKey
          if key in failKeys
            error = new Error "" The specified key does not exist.
            error.name = :NoSuchKey
            Promise.reject error
          else
            Promise.resolve {}

        extractCommonCopyOptions: -> {}

    test "NoSuchKey during copy is handled as warning, not crash" ->
      S3P.copy
        quiet: true
        bucket: :source-bucket
        toBucket: :dest-bucket
        s3: mockS3WithFailingCopy
          [] :alpha :beta :gamma
          [] :beta
        toS3: {} s3: copyObject: -> Promise.resolve {}

      .then ({finalStats}) ->
        assert.eq finalStats.copiedFiles, 2
        assert.eq finalStats.keyDoesNotExistFiles, 1

    test "NotFound during copy is handled as warning (headObject case)" ->
      mockS3WithNotFound = (keys, failKeys) ->
        base = mockS3 keys...
        merge base,
          copy: (options) ->
            key = options.key ? options.fromKey
            if key in failKeys
              error = new Error "" Not Found
              error.name = :NotFound
              Promise.reject error
            else
              Promise.resolve {}

          extractCommonCopyOptions: -> {}

      S3P.copy
        quiet: true
        bucket: :source-bucket
        toBucket: :dest-bucket
        s3: mockS3WithNotFound
          [] :file1 :file2 :file3
          [] :file1 :file3
        toS3: {} s3: copyObject: -> Promise.resolve {}

      .then ({finalStats}) ->
        assert.eq finalStats.copiedFiles, 1
        assert.eq finalStats.keyDoesNotExistFiles, 2

    test "non-NoSuchKey errors still propagate to failed list" ->
      mockS3WithOtherError = (keys) ->
        base = mockS3 keys...
        merge base,
          copy: ->
            Promise.reject new Error :AccessDenied

          extractCommonCopyOptions: -> {}

      S3P.copy
        quiet: true
        bucket: :source-bucket
        toBucket: :dest-bucket
        s3: mockS3WithOtherError [] :alpha
        toS3: {} s3: copyObject: -> Promise.resolve {}

      .then ({finalStats}) ->
        assert.eq finalStats.copiedFiles, 0
        assert.ok finalStats.failed is Array
        failed = finalStats.failed
        assert.eq 1, failed.length

    ## helper: copy rejects with an (already-retry-exhausted) transient error for specific keys
    mockS3WithTransientCopy = (keys, failKeys) ->
      base = mockS3 keys...
      merge base,
        copy: (options) ->
          key = options.key ? options.fromKey
          if key in failKeys
            error = new Error "socket hang up"
            error.name = :TimeoutError
            Promise.reject error
          else
            Promise.resolve {}

        # _copyWrapper consults this to decide transient vs fatal
        _isTransientError: (error) -> error?.name == :TimeoutError
        extractCommonCopyOptions: -> {}

    test "exhausted transient copy error is FATAL by default" ->
      S3P.copy
        quiet: true
        bucket: :source-bucket
        toBucket: :dest-bucket
        s3: mockS3WithTransientCopy
          [] :alpha :beta :gamma
          [] :beta
        toS3: {} s3: copyObject: -> Promise.resolve {}

      .then ({finalStats}) ->
        # default: the transient failure propagates to the failed list, not silently skipped
        assert.ok finalStats.failed is Array
        assert.eq 1, finalStats.failed.length
        assert.eq finalStats.transientCopyFailureFiles ? 0, 0

    test "exhausted transient copy error is skipped & recorded with --skip-failed-transient-copies" ->
      S3P.copy
        quiet: true
        skipFailedTransientCopies: true
        bucket: :source-bucket
        toBucket: :dest-bucket
        s3: mockS3WithTransientCopy
          [] :alpha :beta :gamma
          [] :beta
        toS3: {} s3: copyObject: -> Promise.resolve {}

      .then ({finalStats}) ->
        assert.eq finalStats.copiedFiles, 2
        assert.eq finalStats.transientCopyFailureFiles, 1
        assert.eq finalStats.transientCopyFailureBytes, "beta".length # mock Size = key length
        assert.ok finalStats.transientCopyFailureKeys is Array
        assert.eq finalStats.transientCopyFailureKeys, [] :beta
