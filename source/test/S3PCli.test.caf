import &StandardImport

test "S3PCli" ->
  output = []
  S3PCli.main
    output: (out) => output.push out
    argv: [] :nodeJs :s3p :version
  .then (version) ->
    assert.match
      version
      ///
        ^
        \d+
        \.
        \d+
        \.
        \d+
        (-[0-9A-Za-z.-]+)?  # optional prerelease suffix, e.g. -dev.1
        $


    assert.eq
      output
      [] version